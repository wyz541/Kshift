        <mxCell id="issue-template-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#28253D;whiteSpace=wrap;" value="Issue 模板与准入校验" vertex="1">
          <mxGeometry height="36" width="520" x="620" y="2200" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    classDef dev fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;\n    classDef verify fill:#fff3e0,stroke:#e65100,stroke-width:2px;\n    classDef ai fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,stroke-dasharray: 5 5;\n    classDef merge fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;\n    classDef final fill:#ffebee,stroke:#c62828,stroke-width:2px;\n\n    subgraph 1. 开发与提交流 (Dev &amp; PR)\n        A[执行 Sub Issue] --&gt; B1(task1 开发)\n        A --&gt; B2(task2 开发)\n        A --&gt; B3(task3 开发)\n        \n        B1 --&gt; DevLocal[本地开发 &amp; Commit]\n        B2 --&gt; DevLocal\n        B3 --&gt; DevLocal\n        \n        DevLocal --&gt; PR[发起 Pull Request]\n        \n        %% 重点强化 PR 格式说明\n        PR --&gt; PRDesc[填写 PR 格式说明]\n        PRDesc --&gt; DescDetails[必填: 变更说明 / 核心结论&lt;br&gt;必填: Before / After UI 截图对比&lt;br&gt;选填: 关联依赖状态]\n    end\n\n    subgraph 2. PR 验证与审查 (PR Validation &amp; Review)\n        %% AI 辅助生成\n        PRDesc -. AI 辅助 .-&gt; AIGen[AIGC: 自动提取 Commit 生成初始说明]\n        \n        %% 自动化验证流水线\n        subgraph V_All [自动化验证流水线 (并发执行)]\n            V1[功能验收: Local App 独立测试]\n            V2[视觉验收: AI 截图对比 / 禁用 computer use]\n            V3[格式校验: 检查 PR 模板是否填全]\n        end\n        \n        PRDesc --&gt; V_All\n        \n        V_All --&gt; CI{Code Review / CI 测试}\n        CI -- 拒绝/打回 --&gt; DevLocal\n    end\n\n    subgraph 3. 合并与自动化清理 (Merge &amp; Cleanup)\n        CI -- 通过 --&gt; Merge[合并到 Main]\n        \n        Merge --&gt; C1[触发 CD 自动 Build 构建]\n        Merge --&gt; C2[自动清理本地 Worktree / 临时分支]\n        Merge --&gt; C3[自动关闭关联 Issue &amp; PR]\n    end\n\n    subgraph 4. 终态验收与反馈 (Final Acceptance)\n        C1 --&gt; FinalVerify{UX 终态验收}\n        \n        FinalVerify -- 需 UX 更改 --&gt; UXFix[提交 UX 修复 PR]\n        UXFix --&gt; DevLocal\n        \n        FinalVerify -- 通过 --&gt; UXReport[提供 Before &amp; After UI 截图记录]\n        UXReport --&gt; Concept[更新 Concept Definition / 沉淀文档]\n    end\n\n    class A,B1,B2,B3,DevLocal,PR,PRDesc,DescDetails,UXFix dev;\n    class V_All,V1,V2,V3,CI verify;\n    class AIGen ai;\n    class Merge,C1,C2,C3 merge;\n    class FinalVerify,UXReport,Concept final;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="qTrrW1WlM8hO4f4Poz1e-111">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="4. 终态验收与反馈 (Final Acceptance)" mermaidId="n:4. 终态验收与反馈 (Final Acceptance)" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=#F0FDF4;strokeColor=#4ADE80;fontColor=#000000;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="4. 终态验收与反馈 (Final Acceptance)" id="qTrrW1WlM8hO4f4Poz1e-112">
