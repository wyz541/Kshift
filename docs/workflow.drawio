        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% 定义样式\n    classDef explore fill:#0366d6,stroke:#333,stroke-width:2px,color:#fff;\n    classDef execute fill:#28a745,stroke:#333,stroke-width:2px,color:#fff;\n    classDef decision fill:#6f42c1,stroke:#333,stroke-width:2px,color:#fff;\n    classDef wait fill:#e1e4e8,stroke:#333,stroke-width:1px,color:#333;\n\n    %% 顶部输入\n    Start((输入源)) --&gt; Triage{判断业务性质}\n\n    %% 探索期分支 (左)\n    Triage -- Idea/Question/Research/Discussion/Plan --&gt; ExploreZone[探索区: RFC / Discussion / 设计文档]\n    ExploreZone --&gt; DiscussPhase[异步讨论 / 评审会 / PoC 验证]\n    DiscussPhase --&gt; Consensus{是否达成可执行共识?}\n\n    %% 决策点\n    Consensus -- 否 --&gt; Hang[挂起 / Icebox]\n    Hang -. 条件成熟重新激活 .-&gt; DiscussPhase\n\n    %% 转化为执行\n    Consensus -- 是 (形成最终 Plan) --&gt; CreateIssue[转化为正式 Issue]\n    CreateIssue --&gt; IssueType{Issue 类型}\n    \n    %% 执行期分支 (右)\n    Triage -- 明确 Task/Bug/Backlog --&gt; IssueType\n    \n    IssueType -- Epic / Parent Issue --&gt; SubTasks[拆分 Sub-issues]\n    IssueType -- 独立 Task / Bug --&gt; FormatIssue[按模板规范格式]\n    \n    SubTasks --&gt; FormatIssue\n    FormatIssue --&gt; DevFlow[进入开发流: 创建 worktree, 路由分工等]\n\n    class ExploreZone,DiscussPhase explore;\n    class CreateIssue,IssueType,FormatIssue,DevFlow execute;\n    class Consensus,Triage decision;\n    class Hang wait;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Xy7S__Bsow7QFmvR1DMn-144">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
