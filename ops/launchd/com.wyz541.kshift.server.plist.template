<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wyz541.kshift.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KSHIFT_HOME__/current/bin/kshift-server-run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KSHIFT_ENV_FILE</key>
    <string>__KSHIFT_HOME__/etc/kshift.env</string>
  </dict>
  <key>UserName</key>
  <string>__KSHIFT_SERVICE_USER__</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__KSHIFT_LOG_DIR__/server.log</string>
  <key>StandardErrorPath</key>
  <string>__KSHIFT_LOG_DIR__/server.error.log</string>
</dict>
</plist>
