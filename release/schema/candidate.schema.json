{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://github.com/wyz541/Kshift/release/schema/candidate.schema.json",
  "title": "Kshift release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "channel", "source_commit", "tag", "minimum_os", "database", "provenance", "rollback", "required_platforms", "limitations"],
  "properties": {
    "schema_version": {"const": "1"},
    "product": {"const": "Kshift"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-preview\\.([1-9][0-9]*))?$"},
    "channel": {"enum": ["preview", "stable", "hotfix"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": "string", "pattern": "^v"},
    "minimum_os": {"type": "object", "additionalProperties": false, "required": ["macos", "ios"], "properties": {"macos": {"const": "26.0"}, "ios": {"const": "26.0"}}},
    "database": {"type": "object", "additionalProperties": false, "required": ["engine", "major", "exact_version", "schema_version", "migration_digest"], "properties": {"engine": {"const": "postgresql"}, "major": {"const": 18}, "exact_version": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}, "migration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "provenance": {"type": "object"},
    "rollback": {"type": "object"},
    "required_platforms": {"type": "array", "items": {"enum": ["server", "macos", "ios", "source"]}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
