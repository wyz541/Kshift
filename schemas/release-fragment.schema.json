{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://github.com/wyz541/Kshift/schemas/release-fragment.schema.json",
  "title": "Kshift Release Fragment v1",
  "description": "One platform build contribution to a Kshift release manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "channel",
    "source_commit",
    "platform",
    "architecture",
    "generated_at",
    "assets",
    "signing",
    "provenance",
    "gates",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "product": { "const": "Kshift" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-preview\\.[0-9]+)?$"
    },
    "channel": { "type": "string", "enum": ["preview", "stable", "hotfix"] },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": { "type": "string", "enum": ["macos", "ios", "server", "source"] },
    "architecture": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://github.com/wyz541/Kshift/schemas/release-manifest.schema.json#/$defs/asset" }
    },
    "signing": { "$ref": "https://github.com/wyz541/Kshift/schemas/release-manifest.schema.json#/$defs/signing" },
    "provenance": { "$ref": "https://github.com/wyz541/Kshift/schemas/release-manifest.schema.json#/$defs/provenance" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://github.com/wyz541/Kshift/schemas/release-manifest.schema.json#/$defs/gate" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
