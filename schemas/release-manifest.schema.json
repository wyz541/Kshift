{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://github.com/wyz541/Kshift/schemas/release-manifest.schema.json",
  "title": "Kshift Release Manifest v1",
  "description": "The single source of truth for one Kshift GitHub Release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "channel",
    "tag",
    "source_commit",
    "generated_at",
    "minimum_os",
    "database",
    "assets",
    "signing",
    "sbom",
    "provenance",
    "gates",
    "limitations",
    "rollback",
    "release_status"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "product": { "const": "Kshift" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-preview\\.[0-9]+)?$"
    },
    "channel": {
      "type": "string",
      "enum": ["preview", "stable", "hotfix"]
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-preview\\.[0-9]+)?$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "minimum_os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macos", "ios"],
      "properties": {
        "macos": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "ios": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "major", "exact_version", "schema_version", "migration_digest"],
      "properties": {
        "engine": { "const": "postgresql" },
        "major": { "const": 18 },
        "exact_version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "migration_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "signing": { "$ref": "#/$defs/signing" },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "file", "sha256"],
      "properties": {
        "format": { "type": "string", "enum": ["spdx-json", "cyclonedx-json"] },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "notes"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["new-patch-release", "restore-backup", "manual"]
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "release_status": {
      "type": "string",
      "enum": ["draft", "promoted", "failed"]
    },
    "missing_platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "reason"],
        "properties": {
          "platform": { "type": "string", "enum": ["macos", "ios", "server"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "promotion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_by", "approved_at", "run_id"],
          "properties": {
            "approved_by": { "type": "string", "minLength": 1 },
            "approved_at": { "type": "string", "format": "date-time" },
            "run_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform", "architecture", "role", "size_bytes", "sha256", "signing_status"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "platform": { "type": "string", "enum": ["macos", "ios", "server", "source"] },
        "architecture": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["application", "server-bundle", "source", "manifest", "checksums", "sbom", "evidence", "notes"]
        },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signing_status": {
          "type": "string",
          "enum": ["signed", "notarized", "testflight", "unsigned", "not-applicable"]
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "identity", "notarization"],
      "properties": {
        "status": { "type": "string", "enum": ["signed", "testflight", "ad-hoc", "unsigned"] },
        "identity": { "type": ["string", "null"] },
        "notarization": { "type": "string", "enum": ["passed", "failed", "not-requested", "not-applicable"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "run_id", "run_attempt", "artifact_id"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "artifact_id": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
